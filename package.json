{
  "name": "protocol-guard-ci",
  "version": "0.1.0",
  "description": "Self-hosted security CI for Solidity/Foundry pull requests: risk signals, upgrade safety and evidence. Not a proof of security.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "protocol-guard": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run format:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "@solidity-parser/parser": "^0.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
